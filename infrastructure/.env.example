# This file is safe to commit. Copy it to infrastructure/.env and replace every value.

POSTGRES_DB=tormia
POSTGRES_USER=tormia_app
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_PORT=54329

REDIS_PASSWORD=replace-with-a-second-long-local-password
REDIS_PORT=56379

WORLD_AUTHORITY_PORT=5272

# UDP remains default-off. The default Compose stack does not publish this
# port; these values are for explicit local configuration validation only.
REALTIME_UDP_ENABLED=false
REALTIME_UDP_LISTENER_ENABLED=false
REALTIME_UDP_LISTENER_PORT=5273
REALTIME_UDP_REQUIRE_HTTPS=true
REALTIME_UDP_ALLOW_SINGLE_INSTANCE_DEVELOPMENT=false
REALTIME_UDP_CREDENTIAL_PROTECTION_KEY_BASE64=
REALTIME_UDP_CREDENTIAL_PROTECTION_KEY_ID=
REALTIME_TRUSTED_PROXY_ADDRESSES=
