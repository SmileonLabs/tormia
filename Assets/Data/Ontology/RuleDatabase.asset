      subject: Relation_{npc}_{actor}
      predicate: subject
      obj: ?npc
    - kind: 0
      subject: Relation_{npc}_{actor}
      predicate: target
      obj: ?actor
    - kind: 0
      subject: Relation_{npc}_{actor}
      predicate: state
      obj: Respectful
  - id: QuestConsequenceEvent
    description: Completing the smoke investigation helps the disturbed village recover.
    conditions:
    - kind: 0
      subject: ?actor
      predicate: completed_quest
      obj: InvestigateSmokeAndPanic
    - kind: 0
      subject: ?place
      predicate: state
      obj: Disturbed
    - kind: 0
      subject: ?board
      predicate: offers
      obj: InvestigateSmokeAndPanic
    - kind: 1
      subject: ?place
      predicate: state
      obj: Recovering
    effects:
    - kind: 2
      subject: ?place
      predicate: state
      obj: Recovering
    - kind: 0
      subject: ?board
      predicate: records
      obj: InvestigateSmokeAndPanicCompleted
  - id: CraftStoneAxeRule
    description: Player -- CRAFTED --> StoneAxe
    conditions:
    - kind: 0
      subject: Player
      predicate: combined
      obj: Stone
    - kind: 0
      subject: Player
      predicate: combined
      obj: Stick
    - kind: 1
      subject: Player
      predicate: has_item
      obj: StoneAxe
    effects:
    - kind: 0
      subject: Player
      predicate: has_item
      obj: StoneAxe
    - kind: 1
      subject: Player
      predicate: combined
      obj: Stone
    - kind: 1
      subject: Player
      predicate: combined
      obj: Stick
  - id: TileWaterStatusWetRule
    description: Actor standing on a water tile becomes Wet.
    conditions:
    - kind: 0
      subject: ?actor
      predicate: standing_on
      obj: ?tile
    - kind: 2
      subject: ?tile
      predicate: 
      obj: TerrainTile
    - kind: 0
      subject: ?tile
      predicate: has_element
      obj: Water
    - kind: 1
      subject: ?actor
      predicate: status
      obj: Wet
    effects:
    - kind: 0
      subject: ?actor
      predicate: status
      obj: Wet
  - id: TileFreezingColdExposureRule
    description: Actor standing on a freezing tile is exposed to ColdEnvironment.
    conditions:
    - kind: 0
