MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 696c085a45bd39d46821655a7500dd56, type: 3}
  m_Name: RuleDatabase
  m_EditorClassIdentifier: Assembly-CSharp::Tormia.Ontology.Core.OntologyRuleDatabase
  definitions:
  - id: BurnEvent
    description: A dry plant hit by a fire object starts burning.
    conditions:
    - kind: 0
      subject: ?actor
      predicate: attacks
      obj: ?target
    - kind: 0
      subject: ?actor
      predicate: attacks_with
      obj: ?tool
    - kind: 2
      subject: ?tool
      predicate: 
      obj: Fire
    - kind: 2
      subject: ?target
      predicate: 
      obj: Plant
    - kind: 2
      subject: ?target
      predicate: 
      obj: Dry
    - kind: 1
      subject: ?target
      predicate: state
      obj: Burning
    effects:
    - kind: 0
      subject: ?target
      predicate: state
      obj: Burning
    - kind: 0
      subject: ?target
      predicate: emits
      obj: Fire
  - id: SmokeEvent
    description: A burning object emits smoke, creating a visible world signal.
    conditions:
    - kind: 0
      subject: ?target
      predicate: state
      obj: Burning
    - kind: 1
      subject: ?target
      predicate: emits
      obj: Smoke
    effects:
    - kind: 0
      subject: ?target
      predicate: emits
      obj: Smoke
  - id: FleeEvent
    description: A creature that fears fire flees when a nearby object emits fire.
    conditions:
    - kind: 2
      subject: ?creature
      predicate: 
      obj: Creature
    - kind: 0
      subject: ?creature
      predicate: fears
      obj: Fire
    - kind: 0
      subject: ?emitter
      predicate: emits
      obj: Fire
    - kind: 1
      subject: ?creature
      predicate: intent
      obj: Flee
    effects:
    - kind: 0
      subject: ?creature
      predicate: intent
      obj: Flee
  - id: DisturbanceEvent
    description: A fleeing creature near a village creates a local disturbance.
    conditions:
    - kind: 0
      subject: ?creature
      predicate: intent
      obj: Flee
    - kind: 0
      subject: ?creature
      predicate: near
      obj: ?place
    - kind: 1
      subject: ?place
      predicate: state
      obj: Disturbed
    - kind: 1
      subject: ?place
      predicate: state
      obj: Recovering
    effects:
    - kind: 0
      subject: ?place
      predicate: state
      obj: Disturbed
  - id: QuestHookEvent
    description: A disturbed place and visible smoke expose an investigation quest
      hook.
    conditions:
    - kind: 0
      subject: ?smokeSource
      predicate: emits
      obj: Smoke
    - kind: 0
      subject: ?place
      predicate: state
      obj: Disturbed
    - kind: 2
      subject: ?board
      predicate: 
      obj: QuestBoard
    - kind: 1
      subject: ?board
      predicate: offers
      obj: InvestigateSmokeAndPanic
    effects:
    - kind: 0
      subject: ?board
      predicate: offers
      obj: InvestigateSmokeAndPanic
  - id: NpcFearMoodEvent
    description: A fleeing NPC becomes afraid.
    conditions:
    - kind: 2
      subject: ?npc
      predicate: 
      obj: NPC
    - kind: 0
      subject: ?npc
      predicate: intent
      obj: Flee
    - kind: 1
      subject: ?npc
      predicate: mood
      obj: Afraid
    effects:
    - kind: 0
      subject: ?npc
      predicate: mood
      obj: Afraid
  - id: NpcDistrustEvent
    description: Talking to an afraid NPC makes them distrust the player.
    conditions:
    - kind: 0
      subject: ?actor
      predicate: talks_to
      obj: ?npc
    - kind: 2
      subject: ?npc
      predicate: 
      obj: NPC
    - kind: 0
      subject: ?npc
      predicate: mood
      obj: Afraid
    - kind: 1
      subject: Relation_{npc}_{actor}
      predicate: state
      obj: Distrustful
    effects:
    - kind: 0
      subject: Relation_{npc}_{actor}
      predicate: has_concept
      obj: Relation
    - kind: 0
      subject: Relation_{npc}_{actor}
      predicate: subject
      obj: ?npc
    - kind: 0
      subject: Relation_{npc}_{actor}
      predicate: target
      obj: ?actor
    - kind: 0
      subject: Relation_{npc}_{actor}
      predicate: state
      obj: Distrustful
  - id: NpcRespectEvent
    description: Helping the village earns respect from nearby NPCs.
    conditions:
    - kind: 0
      subject: ?actor
      predicate: helps
      obj: ?place
    - kind: 2
      subject: ?npc
      predicate: 
      obj: NPC
    - kind: 0
      subject: ?npc
      predicate: near
      obj: ?place
    - kind: 1
      subject: Relation_{npc}_{actor}
      predicate: state
      obj: Respectful
    effects:
    - kind: 0
