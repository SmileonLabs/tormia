    - kind: 1
      subject: ?actor
      predicate: animation_intent
      obj: Discomfort
    effects:
    - kind: 0
      subject: ?actor
      predicate: animation_intent
      obj: Discomfort
  - id: LowVitalityAnimationIntentRule3
