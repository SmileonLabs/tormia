    - kind: 0
      subject: ?tile
      predicate: temperature
      obj: Freezing
    - kind: 1
      subject: ?actor
      predicate: exposed_to
      obj: ColdEnvironment
    effects:
    - kind: 0
      subject: ?actor
      predicate: exposed_to
      obj: ColdEnvironment
  - id: SwampResistanceCapabilityRule
    description: SwampResistance equipment gives the actor swamp movement protection.
    conditions:
    - kind: 0
      subject: ?actor
      predicate: equipped_part
      obj: ?part
    - kind: 0
      subject: ?part
      predicate: grants_capability
      obj: SwampResistance
    - kind: 1
      subject: ?actor
      predicate: has_capability
      obj: SwampResistance
    effects:
    - kind: 0
      subject: ?actor
      predicate: has_capability
      obj: SwampResistance
  - id: TileSwampMovementSlowRule
    description: Actor standing on a swamp tile becomes Slowed unless protected by
      SwampResistance.
    conditions:
    - kind: 0
      subject: ?actor
      predicate: standing_on
      obj: ?tile
    - kind: 2
      subject: ?tile
      predicate: 
      obj: TerrainTile
    - kind: 0
      subject: ?tile
      predicate: surface
      obj: Swamp
    - kind: 1
      subject: ?actor
      predicate: has_capability
      obj: SwampResistance
    - kind: 1
      subject: ?actor
      predicate: movement_state
      obj: Slowed
    effects:
    - kind: 0
      subject: ?actor
      predicate: movement_state
      obj: Slowed
  - id: ColdProtectionWarmthRule
    description: ColdProtection equipment keeps a cold-exposed actor Warm.
    conditions:
    - kind: 0
      subject: ?actor
      predicate: exposed_to
      obj: ColdEnvironment
    - kind: 0
      subject: ?actor
      predicate: equipped_part
      obj: ?part
    - kind: 0
      subject: ?part
      predicate: grants_capability
      obj: ColdProtection
    - kind: 1
      subject: ?actor
      predicate: status
      obj: Warm
    effects:
    - kind: 0
      subject: ?actor
      predicate: status
      obj: Warm
  - id: ColdExposureVitalityTickRule
    description: Cold exposure lowers CoreVitality once per simulation tick unless
      the actor is Warm.
    conditions:
    - kind: 0
      subject: Simulation
      predicate: current_tick
      obj: ?tick
    - kind: 0
      subject: ?actor
      predicate: exposed_to
      obj: ColdEnvironment
    - kind: 0
      subject: ?actor
      predicate: core_vitality
      obj: ?vitality
    - kind: 1
      subject: ?actor
      predicate: status
      obj: Warm
    - kind: 1
      subject: ?actor
      predicate: cold_damage_tick
      obj: ?tick
    effects:
    - kind: 3
      subject: ?actor
      predicate: core_vitality
      obj: -1
    - kind: 0
      subject: ?actor
      predicate: cold_damage_tick
      obj: ?tick
  - id: SlowedAnimationIntentRule
    description: Slowed actors prefer impaired movement animation intent.
    conditions:
    - kind: 0
      subject: ?actor
      predicate: movement_state
      obj: Slowed
    - kind: 1
      subject: ?actor
      predicate: animation_intent
      obj: ImpairedMovement
    effects:
    - kind: 0
      subject: ?actor
      predicate: animation_intent
      obj: ImpairedMovement
  - id: ColdAnimationIntentRule
    description: Cold exposure prefers discomfort animation intent.
